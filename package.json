{
  "name": "@kravc/schema",
  "version": "3.0.1",
  "description": "Advanced JSON schema manipulation and validation library.",
  "keywords": [
    "JSON",
    "JSON-LD",
    "Validator",
    "Credential",
    "JSON Schema",
    "Linked Data",
    "Semantic Web",
    "Verifiable Credential"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexkravets/schema.git"
  },
  "directories": {
    "src": "src"
  },
  "scripts": {
    "test": "eslint --fix src/ examples/ && bun run typecheck && bun test --coverage",
    "typecheck": "tsc -p tsconfig.check.json",
    "prebuild": "rimraf dist",
    "build": "tsc",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build"
  },
  "author": "Oleksandr Kravets <a@kra.vc>",
  "license": "ISC",
  "dependencies": {
    "credentials-context": "^2.0.0",
    "lodash": "^4.18.1",
    "security-context": "^4.0.0",
    "validator": "^13.15.35",
    "z-schema": "^12.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/jsonld": "^1.5.15",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/validator": "^13.15.10",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^64.2.0",
    "globals": "^17.11.0",
    "jsonld": "^9.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "undici": "^6.28.0"
  }
}
